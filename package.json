{
  "name": "chiayiyouthlabclock",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build --configLoader runner",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --exclude tests/firestore-rules.test.ts --exclude 'tests/e2e/**'",
    "test:all": "vitest run --exclude 'tests/e2e/**'",
    "test:watch": "vitest --exclude 'tests/e2e/**'",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:emulator": "vitest run --config vitest.emulator.config.ts --configLoader runner",
    "test:emulator:start": "FIREBASE_PROJECT_ID=demo-chiayi-payroll firebase emulators:exec --only firestore --project demo-chiayi-payroll --config firebase.test.json 'npm run test:emulator'",
    "verify:pr13": "node scripts/verify-pr13.mjs",
    "audit:prod": "npm audit --audit-level=high --omit=dev",
    "audit:report": "npm audit --json > audit-report.json",
    "firebase:rules:test": "vitest run --config vitest.emulator.config.ts --configLoader runner tests/firestore-rules.test.ts",
    "firebase:rules:deploy": "npx firebase-tools deploy --only firestore:rules"
  },
  "dependencies": {
    "@sentry/react": "^10.53.1",
    "firebase": "^12.10.0",
    "firebase-admin": "^13.7.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.1",
    "@netlify/functions": "^5.1.2",
    "@playwright/test": "^1.60.0",
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "10.6.1",
    "postcss": "8.5.31",
    "tailwindcss": "3.4.17",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "vitest": "^4.1.6"
  },
  "overrides": {
    "@firebase/firestore": {
      "@grpc/grpc-js": "1.14.6"
    },
    "tailwindcss": {
      "postcss-selector-parser": "7.1.7"
    }
  }
}
